# Copy to ".env" and fill in what you have. Everything is optional.

# AI planner + ticket writer (set ONE)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# Open approved tickets as real GitHub Issues (optional)
GITHUB_TOKEN=
GITHUB_REPO=yourname/yourrepo

# Send alerts to Slack / Discord / Google Chat webhook (optional)
ALERT_WEBHOOK_URL=

# Rules
CERT_WARN_DAYS=30
CERT_CRIT_DAYS=14
DOMAIN_WARN_DAYS=60
DOMAIN_CRIT_DAYS=30
CHECK_INTERVAL_MIN=60
